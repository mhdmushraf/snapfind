{
  "name": "Studio",
  "properties": {
    "about": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "cover_url": {
      "format": "uri",
      "type": "string"
    },
    "custom_domain": {
      "type": "string"
    },
    "download_price": {
      "default": 49,
      "type": "number"
    },
    "faqs": {
      "description": "JSON array of {q,a}",
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "logo_url": {
      "format": "uri",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "packages": {
      "description": "JSON array of {name, price, unit, features[], popular}",
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_credits": {
      "default": 5000,
      "type": "number"
    },
    "plan": {
      "default": "trial",
      "enum": [
        "trial",
        "active",
        "expired"
      ],
      "type": "string"
    },
    "portfolio": {
      "description": "JSON array of photo URLs",
      "type": "string"
    },
    "print_price": {
      "default": 299,
      "type": "number"
    },
    "public_site": {
      "default": true,
      "type": "boolean"
    },
    "r2_prefix": {
      "type": "string"
    },
    "revenue_share": {
      "default": 70,
      "type": "number"
    },
    "sections": {
      "description": "JSON array of enabled section ids in display order",
      "type": "string"
    },
    "services": {
      "description": "JSON array of {title, body} \u2014 what the studio shoots",
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "testimonials": {
      "description": "JSON array of {quote, name, detail}",
      "type": "string"
    },
    "theme": {
      "description": "JSON: {accent, mode, heading, hero}",
      "type": "string"
    },
    "watermark_url": {
      "format": "uri",
      "type": "string"
    },
    "website": {
      "description": "External website link, if they have one",
      "type": "string"
    }
  },
  "required": [
    "name",
    "owner_email",
    "r2_prefix"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}