{
  "name": "Studio",
  "properties": {
    "city": {
      "type": "string"
    },
    "custom_domain": {
      "description": "e.g. gallery.menonstudio.com \u2014 used for QR codes and gallery links once DNS is pointed at the app",
      "type": "string"
    },
    "download_price": {
      "default": 49,
      "description": "INR per full-resolution download",
      "type": "number"
    },
    "logo_url": {
      "format": "uri",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_credits": {
      "default": 5000,
      "type": "number"
    },
    "plan": {
      "default": "trial",
      "enum": [
        "trial",
        "active",
        "expired"
      ],
      "type": "string"
    },
    "print_price": {
      "default": 299,
      "description": "INR per print",
      "type": "number"
    },
    "r2_prefix": {
      "type": "string"
    },
    "revenue_share": {
      "default": 70,
      "description": "Percent of guest orders kept by the studio",
      "type": "number"
    },
    "watermark_url": {
      "format": "uri",
      "type": "string"
    }
  },
  "required": [
    "name",
    "owner_email",
    "r2_prefix"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}