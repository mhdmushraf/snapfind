{
  "name": "Studio",
  "properties": {
    "about": {
      "description": "A few sentences for the public studio page",
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "cover_url": {
      "description": "Hero image on the public studio page",
      "format": "uri",
      "type": "string"
    },
    "custom_domain": {
      "type": "string"
    },
    "download_price": {
      "default": 49,
      "type": "number"
    },
    "instagram": {
      "description": "Handle without the @",
      "type": "string"
    },
    "logo_url": {
      "format": "uri",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_credits": {
      "default": 5000,
      "type": "number"
    },
    "plan": {
      "default": "trial",
      "enum": [
        "trial",
        "active",
        "expired"
      ],
      "type": "string"
    },
    "portfolio": {
      "description": "JSON array of photo URLs chosen for the public studio page",
      "type": "string"
    },
    "print_price": {
      "default": 299,
      "type": "number"
    },
    "public_site": {
      "default": true,
      "description": "Show the public studio page at /<slug>",
      "type": "boolean"
    },
    "r2_prefix": {
      "type": "string"
    },
    "revenue_share": {
      "default": 70,
      "type": "number"
    },
    "slug": {
      "description": "URL handle, e.g. menon-studio \u2014 lives at snapfind.base44.app/menon-studio",
      "type": "string"
    },
    "tagline": {
      "description": "One line under the studio name",
      "type": "string"
    },
    "watermark_url": {
      "format": "uri",
      "type": "string"
    }
  },
  "required": [
    "name",
    "owner_email",
    "r2_prefix"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}