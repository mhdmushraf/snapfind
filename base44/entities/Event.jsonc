{
  "name": "Event",
  "properties": {
    "allow_download": {
      "default": false,
      "type": "boolean"
    },
    "allow_full_gallery": {
      "default": true,
      "type": "boolean"
    },
    "allow_orders": {
      "default": false,
      "description": "Guests can order prints and full-res downloads",
      "type": "boolean"
    },
    "cover_photo_id": {
      "type": "string"
    },
    "event_date": {
      "format": "date",
      "type": "string"
    },
    "expires_on": {
      "format": "date",
      "type": "string"
    },
    "faces_indexed": {
      "default": 0,
      "type": "number"
    },
    "function_type": {
      "default": "wedding",
      "description": "Which function this is within a multi-event package",
      "enum": [
        "wedding",
        "nikah",
        "engagement",
        "haldi",
        "mehndi",
        "reception",
        "sangeet",
        "church",
        "other"
      ],
      "type": "string"
    },
    "groups_data": {
      "description": "JSON of clustered face groups: [{id,label,descriptor,photo_ids,cover}]",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "parent_event_id": {
      "description": "Set when this event is one function inside a package",
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "photo_count": {
      "default": 0,
      "type": "number"
    },
    "photos_processed": {
      "default": 0,
      "type": "number"
    },
    "qr_slug": {
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "uploading",
        "processing",
        "live",
        "expired"
      ],
      "type": "string"
    },
    "studio_id": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "watermark_previews": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "studio_id",
    "name",
    "qr_slug"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}