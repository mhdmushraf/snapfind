{
  "name": "Photo",
  "properties": {
    "blur_score": {
      "description": "0-100, higher = sharper",
      "type": "number"
    },
    "culled": {
      "default": false,
      "type": "boolean"
    },
    "duplicate_of": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "face_count": {
      "default": 0,
      "type": "number"
    },
    "face_data": {
      "description": "JSON array of 128-number face descriptors, one per face found in this photo",
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "indexed": {
      "default": false,
      "description": "True once face descriptors have been computed",
      "type": "boolean"
    },
    "original_filename": {
      "type": "string"
    },
    "preview_key": {
      "type": "string"
    },
    "quality_score": {
      "type": "number"
    },
    "r2_key": {
      "description": "Public URL of the stored image",
      "type": "string"
    },
    "sort_order": {
      "default": 0,
      "type": "number"
    },
    "status": {
      "default": "uploaded",
      "enum": [
        "uploaded",
        "processed",
        "failed"
      ],
      "type": "string"
    },
    "studio_id": {
      "type": "string"
    },
    "taken_at": {
      "format": "date-time",
      "type": "string"
    },
    "thumb_key": {
      "type": "string"
    },
    "width": {
      "type": "number"
    }
  },
  "required": [
    "event_id",
    "r2_key"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}